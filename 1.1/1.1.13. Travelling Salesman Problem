#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF (LLONG_MAX / 4)

int n;
long long **cost;
long long **dp;

long long tsp(int mask, int city) {
    if (mask == (1 << n) - 1) {
        if (cost[city][0] == -1)
            return INF;
        return cost[city][0];
    }

    if (dp[mask][city] != -1)
        return dp[mask][city];

    long long ans = INF;

    for (int next = 0; next < n; next++) {
        if (!(mask & (1 << next)) && cost[city][next] != -1) {
            long long remaining = tsp(mask | (1 << next), next);

            if (remaining != INF) {
                long long total = cost[city][next] + remaining;
                if (total < ans)
                    ans = total;
            }
        }
    }

    return dp[mask][city] = ans;
}
